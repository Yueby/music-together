{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "paths": {
      "@/lib/playbackSoundFactory": ["./src/compat/hostModules/playbackSoundFactory.ts"],
      "@/lib/metadataFetch": ["./src/compat/hostModules/metadataFetch.ts"],
      "@/lib/RoomCommands": ["./src/compat/hostModules/RoomCommands.ts"],
      "@/lib/roomCheck": ["./src/compat/hostModules/roomCheck.ts"],
      "@/lib/audioUnlock": ["./src/compat/hostModules/audioUnlock.ts"],
      "@/lib/hostRuntime": ["./src/compat/hostModules/hostRuntime.ts"],
      "@/lib/storageBackend": ["./src/compat/storageBackend.ts"],
      "@/*": ["../client/src/*"]
    },
    "types": ["vite/client", "node"],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src", "scripts", "vite.config.ts", "../client/src/env.d.ts"]
}
