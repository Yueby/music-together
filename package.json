{
  "name": "music-together",
  "version": "1.0.1",
  "private": true,
  "description": "Online music listening together platform",
  "scripts": {
    "predev": "kill-port 3001 --silent || true",
    "dev": "concurrently --kill-others --names server,client --prefix-colors blue,green \"corepack pnpm@11.21.0 run dev:server\" \"corepack pnpm@11.21.0 run dev:client\"",
    "dev:client": "corepack pnpm@11.21.0 --filter @music-together/client dev",
    "dev:server": "corepack pnpm@11.21.0 --filter @music-together/server dev",
    "build": "corepack pnpm@11.21.0 -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\" \"packages/shared/src/**/*.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=11"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "kill-port": "^2.0.1",
    "prettier": "^3.9.9",
    "vitest": "^5.0.3"
  },
  "workspaces": [
    "packages/*"
  ]
}
