# =============================================================================
# Music Together 服务端配置
# 复制此文件为 .env 并按部署环境填写需要的值
# =============================================================================

# 服务端端口（默认 3001）
# PORT=3001

# 客户端 URL（可选，用于 CORS 严格白名单模式）
# 不设置时使用自动模式；前后端分离部署时建议显式配置。
# CLIENT_URL=https://music.example.com

# 额外允许的 CORS origins，多个来源使用逗号分隔
# CORS_ORIGINS=https://other.example.com,https://another.example.com

# 身份 Cookie HMAC 密钥
# 本地开发可不设置；生产环境必须显式设置至少 32 个字符的随机值。
# 可使用：openssl rand -base64 48
# IDENTITY_SECRET=replace-with-a-long-random-production-secret

# 身份 Cookie 有效期（天，默认 30）
# IDENTITY_TTL_DAYS=30

# 断线重连票据有效期（毫秒，默认与房间宽限期一致：60000）
# REJOIN_TTL_MS=60000

# 是否强制身份 Cookie 使用 Secure；不设置时根据生产环境和代理协议自动判断
# IDENTITY_COOKIE_SECURE=true

# 是否启用网易云/QQ 音乐自动换源（默认 true）
# AUTO_FALLBACK_ENABLED=true

# 信任几层反向代理，决定按 IP 限流时看到的客户端 IP（来自 X-Forwarded-For）。
# 默认 1（前面有一层 Nginx / Caddy / 1Panel）；端口直接暴露、没有反向代理时设为 false，避免客户端伪造 IP；
# 多层代理填实际层数，也可填 loopback 或子网列表。
# TRUST_PROXY=1

# 微应用音频接口提供的最高码率（kbps：128 / 192 / 320 / 999 无损），默认 128。
# 微应用必须经本服务把整首歌下载完才能播放，海外服务器到音乐 CDN 约 1 MB/s：320 kbps 约 10 秒，192 kbps 约 6 秒，128 kbps 约 4 秒。
# 码率越低，服务器出口带宽和成员等待都越少。网页端不受影响，仍按房间音质直连 CDN；房间音质低于该值时按房间音质。
# MAPP_AUDIO_MAX_BITRATE=128

# 微应用音频同时转发的路数（1–32，默认 8）。沙箱只能访问本服务，所以每个成员的每首歌都要经本服务转发；
# 超出的请求最多排队 15 秒，不会被直接拒绝。机器配置高、带宽足时可调大，配置低时可调小。
# MAPP_MAX_STREAMS=8

# TTML 逐词歌词库的 https 地址（服务端按 <地址>/ncm-lyrics/<歌曲ID>.ttml、<地址>/qq-lyrics/<mid>.ttml 取文件，
# 网页端与微应用都经 /api/music/ttml 读取）；默认如下，一般无需设置
# TTML_DB_BASE_URL=https://amlldb.bikonoo.com

# -----------------------------------------------------------------------------
# Discourse 微应用（Linux.do mini app）平台入口，默认关闭
# 下面三项必须同时设置才会启用；全部不设置则与未接入时完全一致。
# 只设置一部分或值非法时服务会拒绝启动，并指出变量名。
# -----------------------------------------------------------------------------
# 论坛地址（https，可带子目录，不以 / 结尾）
# MAPP_ISSUER=https://linux.do

# 本服务的公开 https origin；主机名不能与论坛相同
# MAPP_AUDIENCE=https://music.example.com

# 平台应用页分配的应用 ID（UUIDv7）
# MAPP_APP_ID=00000000-0000-7000-8000-000000000000

# 可选：只读公钥文件的绝对路径（容器内路径）。设置后只从该文件读取公钥，不请求论坛 JWKS
# MAPP_JWKS_FILE=/run/keys/platform-jwks.json

# 可选：同时接受沙箱通道的令牌（默认 false，只接受正式通道）。
# 沙箱构建只有应用作者/管理员能打开，但沙箱会话会与本服务的真实房间共用数据，
# 仅在测试沙箱构建时设为 true，测试完请移除。
# MAPP_ALLOW_SANDBOX=true
